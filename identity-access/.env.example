# Identity & Access local/container configuration.
# Copy to .env and replace every placeholder before using real credentials.

NODE_ENV=development
PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/leapmentor_identity?replicaSet=rs0
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
REDIS_URL=redis://127.0.0.1:6379

JWT_ACCESS_SECRET=local-only-change-me-access-secret
JWT_REFRESH_SECRET=local-only-change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
OAUTH_STATE_SECRET=local-only-change-me-oauth-state-secret

APP_BASE_URL=http://127.0.0.1:5173
CLIENT_URL=http://127.0.0.1:5173

GOOGLE_CLIENT_ID=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=http://127.0.0.1:5001/api/v1/auth/linkedin/callback

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=

PAYMENTS_SERVICE_URL=http://127.0.0.1:5004
PAYMENTS_SERVICE_TOKEN=local-only-change-me-payments-internal-token
PROFILE_SERVICE_TOKEN=local-only-change-me-profile-token
ADMIN_SERVICE_TOKEN=local-only-change-me-admin-token
INTERNAL_HTTP_TIMEOUT_MS=3000
