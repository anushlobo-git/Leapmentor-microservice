# Mentoring Workspace & Realtime local/container configuration.
# Copy to .env and replace every placeholder before using real credentials.

NODE_ENV=development
PORT=5003
MONGO_URI=mongodb://127.0.0.1:27017/leapmentor_workspace?replicaSet=rs0
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=true
NOTIFICATION_STREAM_NAME=leapmentor.notifications

CLIENT_URL=http://127.0.0.1:5173
JWT_ACCESS_SECRET=local-only-change-me-access-secret
WORKSPACE_SERVICE_TOKEN=local-only-change-me-workspace-token
ADMIN_SERVICE_TOKEN=local-only-change-me-admin-token

NOTIFICATIONS_SERVICE_URL=http://127.0.0.1:5005
NOTIFICATIONS_SERVICE_TOKEN=local-only-change-me-workspace-to-notifications-token
INTERNAL_REQUEST_TIMEOUT_MS=3000
