# Profile & Discovery local/container configuration.
# Copy to .env and replace every placeholder before using real credentials.

NODE_ENV=development
PORT=5002
MONGO_URI=mongodb://127.0.0.1:27017/leapmentor_profile?replicaSet=rs0
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
REDIS_URL=redis://127.0.0.1:6379

JWT_ACCESS_SECRET=local-only-change-me-access-secret
IDENTITY_SERVICE_URL=http://127.0.0.1:5001
IDENTITY_SERVICE_TOKEN=local-only-change-me-identity-token
PROFILE_SERVICE_TOKEN=local-only-change-me-profile-token
ADMIN_SERVICE_TOKEN=local-only-change-me-admin-token
WORKSPACE_SERVICE_URL=http://127.0.0.1:5003
WORKSPACE_SERVICE_TOKEN=local-only-change-me-workspace-token
INTERNAL_HTTP_TIMEOUT_MS=3000

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5002/api/v1/google-calendar/callback
GOOGLE_CALENDAR_STATE_SECRET=local-only-change-me-calendar-state-secret
