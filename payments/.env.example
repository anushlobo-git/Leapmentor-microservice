# Payments local/container configuration.
# Copy to .env and replace every placeholder before using real credentials.

NODE_ENV=development
PORT=5004
MONGO_URI=mongodb://127.0.0.1:27017/leapmentor_payments?replicaSet=rs0
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
REDIS_URL=redis://127.0.0.1:6379

JWT_ACCESS_SECRET=local-only-change-me-access-secret
INTERNAL_SERVICE_TOKEN=local-only-change-me-payments-internal-token
WORKSPACE_SERVICE_URL=http://127.0.0.1:5003
WORKSPACE_SERVICE_TOKEN=local-only-change-me-workspace-token
INTERNAL_HTTP_TIMEOUT_MS=3000
COMMISSION_RATE=20
