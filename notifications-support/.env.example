# Notifications & Support local/container configuration.
# Copy to .env and replace every placeholder before using real credentials.

NODE_ENV=development
PORT=5005
MONGO_URI=mongodb://127.0.0.1:27017/leapmentor_notifications?replicaSet=rs0
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=true
NOTIFICATION_STREAM_NAME=leapmentor.notifications
NOTIFICATION_CONSUMER_GROUP=notifications-support
NOTIFICATION_CONSUMER_NAME=notifications-local

JWT_ACCESS_SECRET=local-only-change-me-access-secret
WORKSPACE_SERVICE_TOKEN=local-only-change-me-workspace-to-notifications-token
ADMIN_SERVICE_URL=http://127.0.0.1:5006
ADMIN_SERVICE_TOKEN=local-only-change-me-admin-token

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=

GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=llama-3.1-8b-instant
