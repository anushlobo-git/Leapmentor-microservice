# Admin & Moderation local/container configuration.
# Copy to .env and replace every placeholder before using real credentials.

NODE_ENV=development
PORT=5006
MONGO_URI=mongodb://127.0.0.1:27017/leapmentor_admin?replicaSet=rs0
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
REDIS_URL=redis://127.0.0.1:6379

JWT_ACCESS_SECRET=local-only-change-me-access-secret
JWT_REFRESH_SECRET=local-only-change-me-admin-refresh-secret
ADMIN_ACCESS_EXPIRES_IN=15m
ADMIN_REFRESH_EXPIRES_IN=7d

IDENTITY_SERVICE_URL=http://127.0.0.1:5001
PROFILE_SERVICE_URL=http://127.0.0.1:5002
WORKSPACE_SERVICE_URL=http://127.0.0.1:5003
PAYMENTS_SERVICE_URL=http://127.0.0.1:5004
ADMIN_SERVICE_TOKEN=local-only-change-me-admin-token
INTERNAL_SERVICE_TOKEN=local-only-change-me-internal-token
INTERNAL_HTTP_TIMEOUT_MS=3000
